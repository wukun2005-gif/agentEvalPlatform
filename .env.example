# agentEvaluator demo 环境变量示例
# 复制为 .env 并填实际值,然后 `npm run dev` 自动加载

# === LLM 配置 ===
# OpenAI / OpenAI-compatible API key
# 留空 = fixture 模式(4 个 canned query,无需联网)
OPENAI_API_KEY=

# 自定义 baseURL(支持 Azure OpenAI / Ollama / vLLM / LM Studio)
# 不填默认 https://api.openai.com/v1
LLM_BASE_URL=https://api.openai.com/v1

# 模型名(不填默认 gpt-4o-mini)
LLM_MODEL=gpt-4o-mini

# 当前 provider(openai / anthropic / google / deepseek / qwen / glm / moonshot / volcengine)
# 仅用于 UI 展示,不影响实际调用(SDK 仍按 baseURL + key 推断)
LLM_PROVIDER=openai

# 模式: auto | live | fixture
# auto: 有 key 走 live,没 key 走 fixture
# live: 强制 live(没 key 会报错)
# fixture: 强制 fixture(忽略 key,录视频用)
LLM_MODE=auto

# === 服务端口 ===
# 不填默认 3000
# PORT=3000
